# URL canónica del sitio (producción)
NEXT_PUBLIC_SITE_URL=https://www.rhinoscopy.com.ar

# Google Analytics 4 (opcional). Si no lo usás, dejalo vacío.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Web Analytics: sin API key. En vercel.com → proyecto → Analytics → Enable Web Analytics → redeploy.
# Depuración en local: NEXT_PUBLIC_VERCEL_ANALYTICS_DEBUG=true (consola del navegador).
# NEXT_PUBLIC_VERCEL_ANALYTICS_DEBUG=

# Search Console (opcional)
# GOOGLE_SITE_VERIFICATION=

# Certificados: false = pantalla “Próximamente”
# NEXT_PUBLIC_CERTIFICADOS_PORTAL_ENABLED=true
